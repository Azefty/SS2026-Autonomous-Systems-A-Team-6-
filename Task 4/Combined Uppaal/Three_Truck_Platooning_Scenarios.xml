// Time unit assumption: 1 UPPAAL time unit = 1 ms
//
// Scenario A: Stopped vehicle/debris and emergency braking
// Scenario B: Vehicle cut-in and platoon reconfiguration
// Scenario C: Platoon formation/joining

// ============================================================
// Scenario A declarations
// ============================================================
clock s1_x;
clock s1_y;
clock t;

broadcast chan s1_brakeWarning;
broadcast chan s1_fallback;

// ============================================================
// Scenario B declarations
// ============================================================
const int DETECTION_TIME = 200;
const int NOTIFICATION_TIME = 100;
const int DISTANCE_ADJUSTMENT_TIME = 500;
const int REFORMATION_TIME = 10000;
const int ACK_TIMEOUT = 100;

const int REQUIRED_ACKS = 2;

broadcast chan cutIn;
broadcast chan cutInAlert;
broadcast chan enterReconfiguration;
broadcast chan increaseDistance;
broadcast chan reformPlatoon;
broadcast chan safeFallback;

chan alertPrepared;
chan ack;
chan alertConfirmed;
chan safeDistanceReachedSig;
chan intruderLeft;
chan communicationTimeout;

bool intruder_present = false;
bool platoon_normal = true;
bool safe_distance = false;
bool communication_ok = true;
bool fallback_mode = false;
bool collision = false;

int[0, REQUIRED_ACKS] ack_count = 0;

// ============================================================
// Scenario C declarations
// Renamed clocks prevent conflicts with local clocks in Scenario B.
// ============================================================
clock c_x, c_y, c_z, c_s;

const int AUTH_TIME = 2;
const int CONFIRM_TIME = 5;
const int SETUP_TIME = 30;

const int N = 3;
typedef int[0, N-1] tid_t;

int[0,100] gap = 50;
const int MIN_GAP = 10;
int[0,10] constraints = 0;

bool platoon_formed = false;
bool v2v_ok = true;

broadcast chan join_req;
broadcast chan join_confirm;
chan split_req;
chan slowDown;
chan safe;
chan bcast_emergency;
